---
/*
 * Docs sidebar (docs/shep-design/README.md, "Screens > 2. Docs > Sidebar").
 * Seven parts and twenty-seven numbered chapters, read off
 * web/src/data/docs-nav.ts's flattened `chapters` list. Active item: butter
 * fill, ink text, 700 weight, 2px ink border. Inactive: transparent,
 * --ink-2, 400.
 *
 * An unbuilt chapter renders as a <span>, not an <a>, and carries a "soon"
 * tag. That is not cosmetic: its page does not exist, so an anchor would be
 * a link to a 404 sitting in the sidebar of every page on the site. There
 * were no unbuilt chapters until the book gained two, which is why this
 * component happily rendered them as links for so long.
 *
 * Mobile (below 860px, the width DocsLayout.astro collapses the sidebar
 * column at): the handoff calls a fixed 264px column beside an 860px
 * article the biggest unsolved gap and asks for "a collapsible docs
 * sidebar" as one real option. This is that — a native <details>/<summary>
 * disclosure, collapsed by default so a phone visitor sees the article
 * almost immediately instead of scrolling past ten nav links first, with a
 * "Menu" bar that expands the same three groups in place.
 *
 * No client JS: <details> is natively keyboard- and screen-reader-operable
 * as a disclosure widget, so this needs no toggle script and keeps working
 * with JS disabled. Desktop forces the content permanently open at >=861px
 * with two rules, both needed: `.sidebar-content { display: block }` beats
 * the old UA default (`details:not([open]) > *:not(summary){display:none}`)
 * on engines that still use it, but modern Chromium wraps the content in a
 * `::details-content` pseudo-element carrying its own
 * `content-visibility: hidden` while closed, which a descendant's
 * `display: block` cannot override — `.docs-sidebar::details-content {
 * content-visibility: visible }` is what actually beats that. Confirmed by
 * looking at a real desktop viewport, not just by reading the spec.
 */
import { chapters } from "../../data/docs-nav";

interface Props {
  activeSlug: string;
}

const { activeSlug } = Astro.props;

/** Consecutive chapters sharing a part, so the markup stays one loop. */
const parts: { label: string; chapters: typeof chapters }[] = [];
for (const chapter of chapters) {
  const last = parts.at(-1);
  if (last?.label === chapter.part) last.chapters.push(chapter);
  else parts.push({ label: chapter.part, chapters: [chapter] });
}
---

<details class="docs-sidebar">
  <summary class="menu-toggle">
    <span>Menu</span>
    <svg class="chevron" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
      <path d="M2 4.5 7 9.5 12 4.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </summary>
  <div class="sidebar-content">
    {
      parts.map((part) => (
        <div class="group">
          <div class="group-label">{part.label}</div>
          <div class="items">
            {part.chapters.map(({ number, item }) => {
              const active = item.slug === activeSlug;
              const body = (
                <>
                  <span class="num">{number}</span>
                  <span class="name">{item.label}</span>
                  {!item.built && <span class="tag">soon</span>}
                </>
              );
              return item.built ? (
                <a href={`/docs/${item.slug}`} class:list={["item", active && "active"]}>
                  {body}
                </a>
              ) : (
                <span class="item unbuilt">{body}</span>
              );
            })}
          </div>
        </div>
      ))
    }
    <div class="footnote">
      Docs track the repo. Anything marked <span class="mono">soon</span>{" "}
      exists in <span class="mono">/docs</span> but hasn't been brought over
      yet.
    </div>
  </div>
</details>

<style>
  .docs-sidebar {
    position: sticky;
    top: 64px;
    padding: 34px 24px 60px;
    border-right: 3px solid var(--line);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .menu-toggle {
    display: none;
  }

  .group {
    margin-bottom: 28px;
  }

  .group-label {
    font-family: "Space Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 12px;
  }

  .items {
    display: grid;
    gap: 3px;
  }

  .item {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 400;
    font-size: 14.5px;
    text-align: left;
    background: transparent;
    color: var(--ink-2);
    border: 2px solid transparent;
    border-radius: 10px;
    padding: 8px 11px;
    cursor: pointer;
    display: grid;
    grid-template-columns: 1.4em 1fr auto;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
  }

  .num {
    font-family: "Space Mono", monospace;
    font-size: 11.5px;
    color: var(--ink-3);
    text-align: right;
  }

  .item.active .num {
    color: var(--ink);
  }

  .unbuilt {
    color: var(--ink-3);
    cursor: default;
  }

  .unbuilt:hover {
    border-color: transparent;
  }

  .item:hover {
    border-color: var(--hair);
    color: var(--ink-2);
  }

  .item.active {
    font-weight: 700;
    background: var(--butter);
    color: var(--ink);
    border-color: var(--line);
  }

  .item.active:hover {
    color: var(--ink);
  }

  .tag {
    font-family: "Space Mono", monospace;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bark);
  }

  .footnote {
    border-top: 2px solid var(--hair);
    padding-top: 18px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink-3);
  }

  .mono {
    font-family: "Space Mono", monospace;
  }

  /* Desktop: ignore the <details> open/closed state entirely and always
     show the nav — see the component doc comment for why this plain
     selector is enough to beat the browser's own hiding rule. */
  @media (min-width: 861px) {
    .sidebar-content {
      display: block;
    }

    /* Modern Chromium wraps <details> content in a ::details-content
       pseudo-element that carries its own `content-visibility: hidden`
       while the element is closed — a `display: block` on a descendant
       cannot override that. This rule targets the pseudo-element itself
       so the content actually paints on desktop; engines without it just
       ignore an unknown pseudo-element and fall back to the rule above. */
    .docs-sidebar::details-content {
      content-visibility: visible;
      block-size: auto;
    }
  }

  @media (max-width: 860px) {
    .docs-sidebar {
      position: static;
      /* The desktop rule caps the column so it can scroll beside the
         article. Here the whole disclosure is in the page flow, so the cap
         would clip the expanded menu and give it a second scrollbar. */
      max-height: none;
      overflow-y: visible;
      border-right: none;
      border-bottom: 3px solid var(--line);
      padding: 0;
    }

    /* Kill the default disclosure triangle so .chevron is the only marker. */
    .docs-sidebar summary {
      list-style: none;
    }

    .docs-sidebar summary::-webkit-details-marker {
      display: none;
    }

    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 16px 20px;
      font-family: "Bricolage Grotesque", sans-serif;
      font-weight: 800;
      font-size: 15px;
      cursor: pointer;
    }

    .chevron {
      color: var(--ink-3);
      transition: transform 0.15s ease;
      flex: none;
    }

    .docs-sidebar[open] .chevron {
      transform: rotate(180deg);
    }

    .sidebar-content {
      padding: 4px 20px 24px;
      border-top: 2px solid var(--hair);
    }
  }
</style>
