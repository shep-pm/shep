---
/*
 * Docs prose callout (docs/shep-design/README.md's Getting started spec).
 * "careful" — bark border, bark-filled tag. "note" — line-colored border,
 * butter-filled tag.
 */
interface Props {
  variant: "careful" | "note";
}

const { variant } = Astro.props;
---

<div class:list={["callout", variant]}>
  <span class="tag">{variant}</span>
  <div class="body"><slot /></div>
</div>

<style>
  .callout {
    background: var(--paper-2);
    border-radius: 16px;
    padding: 18px 20px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    margin: 0 0 40px;
  }

  .callout.careful {
    border: 3px solid var(--bark);
  }

  .callout.note {
    border: 3px solid var(--butter);
  }

  .tag {
    font-family: "Space Mono", monospace;
    font-weight: 700;
    font-size: 11.5px;
    border: 2px solid var(--line);
    border-radius: 7px;
    padding: 4px 9px;
    white-space: nowrap;
  }

  .careful .tag {
    background: var(--bark);
    color: var(--paper-2);
  }

  .note .tag {
    background: var(--butter);
    color: var(--ink);
  }

  /*
   * A div, not a p, because a caller can pass paragraphs and a <p> cannot
   * hold one: the parser closes the wrapper and every paragraph becomes a
   * grid item of its own. On /docs/writing-a-dog that put a paragraph in the
   * tag's column, which is sized to its content, so the column took 267px of
   * the 327 available and the body column was left at zero. The text ran
   * 54px past the right edge of the page, and the page scrolled sideways.
   */
  .callout .body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* The prose belongs to the caller, so these have to reach out of scope. */
  .callout .body :global(p) {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .callout .body :global(p + p) {
    margin-top: 12px;
  }

  .callout :global(code) {
    font-family: "Space Mono", monospace;
    font-size: 13.5px;
    background: var(--code-bg);
    border-radius: 5px;
    padding: 1px 6px;
  }
</style>
