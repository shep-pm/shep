---
import { REPO } from "../../data/repo";
/*
 * Reference pills — Source / API / Spec links under a docs page's <h1>.
 * One shared component reading web/src/data/
 * docs-nav.ts's per-item source/spec/api fields, so a page's pills can't
 * drift from its own metadata and a new page can't ship without at least
 * a Source pill — that field has no `?`, so leaving it off is a type error,
 * not a silent gap.
 *
 * Source and Spec both point into the GitHub repo, which went public on
 * 2026-08-16; API points at docs.rs, which has had shep-core since its
 * first publish. Every pill resolves, so every pill is a plain `<a>`.
 *
 * Until 2026-09-21 a `pillTargetsLive` flag let a kind render dimmed and
 * inert with a tooltip saying why, for the months when a GitHub link 404'd
 * and docs.rs had nothing. Both flags had been true since the launch they
 * were waiting on, so the dimmed branch was unreachable and its two tooltips
 * still read "the repo is private until launch". Bring the flag back if a
 * fourth pill kind ever points somewhere that does not exist yet.
 */
import { docsNav } from "../../data/docs-nav";

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const item = docsNav.flatMap((group) => group.items).find((i) => i.slug === slug);

if (!item) {
  throw new Error(`ReferencePills: no docsNav item for slug "${slug}"`);
}


const SPEC_FILE = "docs/specs/shep-v1.md";

const sources = Array.isArray(item.source) ? item.source : [item.source];

const pills = [
  ...sources.map((path) => ({
    kind: "Source" as const,
    label: path,
    href: `${REPO}/blob/main/${path}`,
  })),
  item.spec && {
    kind: "Spec" as const,
    label: item.spec.label,
    href: `${REPO}/blob/main/${SPEC_FILE}#${item.spec.anchor}`,
  },
  item.api && {
    kind: "API" as const,
    label: item.api.label,
    href: `https://docs.rs/shep-core/latest/shep_core/${item.api.path}`,
  },
].filter(Boolean) as {
  kind: "Source" | "Spec" | "API";
  label: string;
  href: string;
}[];
---

<div class="ref-pills" data-pagefind-ignore>
  {
    pills.map((pill) => (
      <a class="pill" href={pill.href} target="_blank" rel="noopener noreferrer">
        <span class="kind">{pill.kind}</span>
        <span class="label">{pill.label}</span>
      </a>
    ))
  }
</div>

<style>
  .ref-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 26px;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: "Space Mono", monospace;
    font-size: 12px;
    line-height: 1.4;
    background: var(--paper-2);
    border: 2px solid var(--line);
    border-radius: 20px;
    padding: 4px 12px 4px 6px;
    text-decoration: none;
    color: var(--ink);
    max-width: 100%;
  }

  a.pill:hover {
    border-color: var(--sky);
    color: var(--ink);
  }

  .kind {
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--ink);
    border-radius: 12px;
    padding: 2px 8px;
    flex: none;
  }

  .label {
    overflow-wrap: anywhere;
    color: var(--ink-2);
  }
</style>
