---
/*
 * Community dogs (web/src/data/dogs.ts, backed by web/public/dogs.json).
 * The two built-in dogs, metrics and bark, live at /docs/dogs. This page is
 * the third source: dogs adopted with `shep adopt` instead of shipped
 * inside the binary. `dogs.ts` already validated the index at import time,
 * so every field read below is trusted.
 *
 * Not a third-party page, despite the name: every entry so far is a shep-pm
 * repository, so the lede and the callout leave authorship to each entry's
 * repository link.
 *
 * Restructured 2026-09-14 per docs/writing-plans/plans/2026-09-14-docs-the-rest.md,
 * Task 4: a short version up top; the naming gotcha moved behind
 * <details>. Already short, so shape rather than cuts.
 */
import DocsLayout from "../../layouts/DocsLayout.astro";
import { slugify } from "../../data/slug";
import ReferencePills from "../../components/docs/ReferencePills.astro";
import Callout from "../../components/docs/Callout.astro";
import CodeBlock from "../../components/docs/CodeBlock.astro";
import ShortVersion from "../../components/docs/ShortVersion.astro";
import { dogs, anchorOf, CATEGORIES, type Dog, type DogCategory } from "../../data/dogs";

function categoryLabel(category: DogCategory): string {
  return category.charAt(0).toUpperCase() + category.slice(1);
}

// One section per category, in CATEGORIES order, dropping any category
// nobody has filed an entry under rather than rendering an empty heading.
const groups = CATEGORIES.map((category) => ({
  category,
  label: categoryLabel(category),
  entries: dogs.filter((dog) => dog.category === category),
})).filter((group) => group.entries.length > 0);

function installLine(dog: Dog): string {
  switch (dog.source.kind) {
    case "cargo":
      // The version is part of the command for a pre-release: cargo
      // resolves `*` otherwise, and `*` never matches one.
      return dog.source.version
        ? `$ cargo install ${dog.package} --version ${dog.source.version}`
        : `$ cargo install ${dog.package}`;
    case "cargo-git":
      return `$ cargo install --git ${dog.source.url}`;
    case "go-install":
      return `$ go install ${dog.source.module}@latest`;
    case "manual":
      return dog.source.instructions;
  }
}

function adoptLine(dog: Dog): string {
  switch (dog.source.kind) {
    case "cargo":
    case "cargo-git":
      return `$ shep adopt ~/.cargo/bin/${dog.package} --name ${dog.adopt_as}`;
    case "go-install":
      return `$ shep adopt $(go env GOPATH)/bin/${dog.package} --name ${dog.adopt_as}`;
    case "manual":
      return `$ shep adopt <path to the binary> --name ${dog.adopt_as}`;
  }
}
---

<DocsLayout
  activeSlug="community-dogs"
>
  <article>
    <h1>Community dogs</h1>
    <ReferencePills slug="community-dogs" />
    <p class="lede">
      <code>metrics</code> and <code>bark</code> ship inside the{" "}
      <code>shep</code> binary. Everything below is a separate binary you
      install yourself and hand to <code>shep adopt &lt;path&gt;</code>.
      Some are ours and some are not; the repository link says which.
    </p>

    <ShortVersion>
      <CodeBlock>{`$ shep dogs --available`}</CodeBlock>
    </ShortVersion>

    <p>
      That prints the install and adopt commands below, narrowed with an
      optional filter.
    </p>

    <Callout variant="careful">
      Being listed here means three things and nothing more: the repository
      is real, the license is open, and the thing is genuinely a dog. It is
      not a review. For a dog we did not write, nobody here has read the
      code. Adopting one runs it at the shepherd's own trust level, the same
      as anything else your Flockfile already starts.
    </Callout>

    <details>
      <summary>A naming gotcha before you adopt one</summary>
      <p>
      A crate's binary doesn't have to share its package name, and{" "}
      <code>CARGO_INSTALL_ROOT</code> or <code>GOBIN</code> can move where
      the installer puts the file, so check where it actually landed before
      adopting it. Getting the path wrong is loud, since{" "}
      <code>shep adopt</code> refuses a path that isn't there. Getting the
      name wrong is silent, which is exactly why <code>adopt_as</code>{" "}
      exists as its own field instead of reusing the package name.
    </p>
    </details>

    {
      groups.map((group) => (
        <section class="dog-category">
          <h2 id={slugify(group.label)}>{group.label}</h2>
          {group.entries.map((dog) => (
            <article class="dog-entry">
              {/* The anchor sits on the heading, not the article: that keeps
                  the entry in the document outline and in the anchor check's
                  reach, and the fragment is unchanged either way. */}
              <h3 id={anchorOf(dog)}>
                <a href={`#${anchorOf(dog)}`}>
                  {dog.package} ({dog.name})
                </a>
              </h3>
              <p>{dog.description}</p>
              <p class="meta">
                {dog.license} ·{" "}
                <a href={dog.repo} target="_blank" rel="noopener noreferrer">
                  Repository
                </a>
              </p>
              {dog.source.kind === "manual" ? (
                <>
                  <p>
                    <strong>Install:</strong> {dog.source.instructions}
                  </p>
                  <CodeBlock label="adopt" iconCopy>
                    {adoptLine(dog)}
                  </CodeBlock>
                </>
              ) : (
                <CodeBlock label="install & adopt" iconCopy>
                  {`${installLine(dog)}\n${adoptLine(dog)}`}
                </CodeBlock>
              )}
            </article>
          ))}
        </section>
      ))
    }

    <h2 id="add-a-dog">Add a dog</h2>
    <p>
      Add yours by editing <code>web/public/dogs.json</code> and opening a
      pull request. Point your editor at{" "}
      <a href="/dogs.schema.json">the published schema</a> and it will tell
      you what an entry needs while you type it. The build runs its own
      validator over every entry before the site ships, and a test keeps the
      two in step, so a pull request that satisfies the schema will not
      surprise you in CI.
    </p>
  </article>
</DocsLayout>

<style>
  .dog-category {
    margin-bottom: 8px;
  }

  .dog-entry {
    border: 3px solid var(--line);
    border-radius: 18px;
    padding: 22px 24px 4px;
    margin: 0 0 24px;
    background: var(--paper-2);
  }

  .dog-entry .meta {
    font-size: 14.5px;
    color: var(--ink-3);
  }

  .dog-entry p {
    color: var(--ink-2);
  }
</style>
