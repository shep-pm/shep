  { metric: "Log-plane CPU per line", shep: "2.27 us", pm2: "4.10 us", ratio: "1.8x" },
  { metric: "Start ten apps, cold daemon", shep: "0.195 s", pm2: "0.366 s", ratio: "1.9x" },
