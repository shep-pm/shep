        <span><code>cwd</code></span>
      </div>
      <div class="row">
        <span><code>pm_exec_path</code></span>
        <span><code>script</code></span>
      </div>
      <div class="row">
        <span><code>args</code></span>
        <span><code>args</code></span>
      </div>
      <div class="row">
        <span><code>exec_interpreter</code></span>
        <span><code>interpreter</code>: absent when it was <code>"none"</code></span>
      </div>
      <div class="row">
        <span><code>autorestart</code></span>
        <span><code>autorestart</code></span>
      </div>
      <div class="row">
        <span><code>restart_delay</code> (ms)</span>
        <span><code>restart_delay</code></span>
      </div>
      <div class="row">
        <span><code>merge_logs</code></span>
        <span><code>merge_logs</code></span>
      </div>
      <div class="row">
        <span><code>max_memory_restart</code> (bytes)</span>
        <span><code>max_memory</code>: enforced against the whole process tree, not just the root pid</span>
      </div>
      <div class="row">
        <span>rows sharing a <code>name</code></span>
        <span><code>instances</code>: the row count</span>
      </div>
