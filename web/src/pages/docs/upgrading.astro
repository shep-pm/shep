    font-family: "Space Mono", monospace;
    font-size: 13.5px;
    line-height: 1.85;
    background: var(--code-bg);
    border: 3px solid var(--line);
    border-radius: 14px;
    padding: 16px 18px;
    margin: 0 0 26px;
    overflow-x: auto;
  }

  .prompt {
    color: var(--ink-3);
    margin-right: 8px;
  }

  .muted {
    color: var(--ink-3);
  }
</style>
