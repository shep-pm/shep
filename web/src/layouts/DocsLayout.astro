---
/*
 * Docs shell — sticky header, 264px sidebar, article column, footer
 * (docs/shep-design/README.md, "Screens > 2. Docs > Layout"). Wraps every
 * /docs/* route. Real routes, not the prototype's client-side page state —
 * each page here is its own file under web/src/pages/docs/.
 *
 * `data-pagefind-body` on `<main>` is what Pagefind (`npm run build` runs it
 * over `dist/` after `astro build`) indexes — the landing page carries no
 * such attribute, so it's excluded from the search index entirely, and the
 * repeated footer license line is carved back out with
 * `data-pagefind-ignore` so it doesn't pad every page's excerpt with the
 * same boilerplate. See DocsSearch.astro for the query UI.
 */
import Base from "./Base.astro";
import DocsHeader from "../components/docs/DocsHeader.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import ChapterBar from "../components/docs/ChapterBar.astro";
import StillStuck from "../components/docs/StillStuck.astro";
import { chapterFor } from "../data/docs-nav";
import "../styles/docs-page.css";

interface Props {
  /** Sidebar slug to highlight, e.g. "getting-started". */
  activeSlug: string;
}

const { activeSlug } = Astro.props;

/*
 * The chapter's name and part both come from docs-nav.ts, so moving a
 * chapter or renaming one is a single edit there rather than one per page.
 * Before this, every page hand-wrote its own crumb, and each repeated the
 * group label, so reordering the book by hand would have left twenty-five
 * crumbs naming parts that no longer existed.
 *
 * A slug that is not in the nav is a page nothing links to and the sidebar
 * cannot show. That fails the build here rather than rendering an empty
 * crumb nobody notices.
 */
const found = chapterFor(activeSlug);
if (!found) {
  throw new Error(
    `activeSlug "${activeSlug}" is not in docs-nav.ts. Add the page to the nav, or fix the slug.`,
  );
}
const title = found.chapter.item.label;
const description = found.chapter.item.summary;
const crumb = `${found.chapter.part} / ${found.chapter.item.label}`;
---

<Base title={`shep docs · ${title}`} description={description}>
  <div class="docs-shell">
    <DocsHeader />
    <div class="grid">
      <DocsSidebar activeSlug={activeSlug} />
      <main data-pagefind-body>
        <div class="crumb">{crumb}</div>
        <slot />
        <ChapterBar activeSlug={activeSlug} />
        <StillStuck />
        <footer class="docs-footer" data-pagefind-ignore>
          <span class="license">
            shep docs · pre-release · MIT OR Apache-2.0
          </span>
        </footer>
      </main>
    </div>
  </div>
  <script>
    // Turns every id-bearing section heading into something a reader can
    // click to get its URL. Ids are authored in the pages themselves; this
    // only draws the handle, so deep links keep working with this blocked.
    for (const heading of document.querySelectorAll<HTMLElement>(
      ".docs-shell main h2[id], .docs-shell main h3[id]",
    )) {
      const link = document.createElement("a");
      link.className = "heading-anchor";
      link.href = `#${heading.id}`;
      // The glyph is a CSS ::before, not text. Text here would join the
      // heading's own textContent, so the accessible name became
      // "#The dogs table" and Pagefind indexed the same.
      link.setAttribute(
        "aria-label",
        `Link to ${heading.textContent?.trim() ?? "this section"}`,
      );
      heading.prepend(link);
    }
  </script>
</Base>

<style>
  .docs-shell {
    min-height: 100vh;
  }

  .grid {
    max-width: 1340px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 264px minmax(0, 1fr);
    gap: 0;
    align-items: start;
  }

  main {
    padding: 44px 56px 90px;
    max-width: 860px;
    min-width: 0;
  }

  .crumb {
    font-family: "Space Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 16px;
  }

  .docs-footer {
    margin-top: 56px;
    padding-top: 26px;
    border-top: 3px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .license {
    font-family: "Space Mono", monospace;
    font-size: 12.5px;
    color: var(--ink-3);
  }

  .dl-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--sky);
    text-decoration: none;
    border-bottom: 2.5px solid var(--sky);
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }

    main {
      max-width: none;
      padding: 32px 24px 70px;
    }
  }

  /*
   * Docs-scoped link color: sky, not the landing page's meadow default
   * (global.css's header comment calls this out as the docs override to
   * make once docs existed). Button-styled anchors (the reference pills, the
   * footer's "design language" link, each page's own card links) set
   * `color` in their own component-scoped styles, which win on specificity
   * over this plain `main a` rule — no exclusion list needed.
   */
  main :global(a) {
    color: var(--sky);
  }

  main :global(a:hover) {
    color: var(--bark);
  }

  /*
   * Inline code chip, shared by every docs page's prose and by the
   * Terminology table's mdInlineToHtml output — one rule instead of
   * repeating it per page.
   */
  main :global(code) {
    font-family: "Space Mono", monospace;
    font-size: 0.88em;
    background: var(--code-bg);
    border-radius: 5px;
    padding: 1px 6px;
    overflow-wrap: anywhere;
  }
</style>
