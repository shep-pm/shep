      "license": "MIT OR Apache-2.0",
      "category": "interactive",
      "source": {
        "kind": "cargo",
        "version": "0.3.4"
      },
      "needs": [
        "alerts"
      ]
    },
    {
      "name": "Paddy",
      "package": "shep-paddock",
      "adopt_as": "paddock",
