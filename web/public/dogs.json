{
  "$schema": "./dogs.schema.json",
  "version": 1,
  "shep": "0.24.2",
  "dogs": [
    {
      "name": "Bella",
      "package": "shep-log-rotate",
      "adopt_as": "log-rotate",
      "description": "Rotates grown log files and asks the shepherd to reopen them.",
      "repo": "https://github.com/shep-pm/shep-log-rotate",
      "license": "MIT OR Apache-2.0",
      "category": "logs",
      "source": {
        "kind": "cargo",
        "version": "0.2.10"
      },
      "needs": [
        "logs"
      ]
    },
    {
      "name": "Moon",
      "package": "shep-deploy",
      "adopt_as": "deploy",
      "description": "Watches a git branch, builds a release in an isolated directory, swaps to it, and rolls back on its own if the new release does not come up.",
      "repo": "https://github.com/shep-pm/shep-deploy",
      "license": "MIT OR Apache-2.0",
      "category": "deploy",
      "source": {
        "kind": "cargo",
        "version": "0.7.0"
      }
    },
    {
      "name": "Wumpus",
      "package": "shep-discord",
      "adopt_as": "discord",
      "description": "Streams a sheep's output into Discord channels, keeps a live embed for each one, and drives the flock from slash commands.",
      "repo": "https://github.com/shep-pm/shep-discord",
      "license": "MIT OR Apache-2.0",
      "category": "interactive",
      "source": {
        "kind": "cargo",
        "version": "0.3.4"
      },
      "needs": [
        "alerts"
      ]
    },
    {
      "name": "Paddy",
      "package": "shep-paddock",
      "adopt_as": "paddock",
      "description": "Leases one host's GPU and RAM to model servers and jobs, behind a single endpoint.",
      "repo": "https://github.com/shep-pm/shep-paddock",
      "license": "MIT OR Apache-2.0",
      "category": "other",
      "source": {
        "kind": "cargo"
      }
    },
    {
      "name": "Bao",
      "package": "shep-openbao",
      "adopt_as": "openbao",
      "description": "Mirrors secrets from OpenBao into shep's secrets store.",
      "repo": "https://github.com/shep-pm/shep-openbao",
      "license": "MIT OR Apache-2.0",
      "category": "other",
      "source": {
        "kind": "cargo"
      }
    },
    {
      "name": "Sandy",
      "package": "shep-sandbox",
      "adopt_as": "sandbox",
      "description": "Runs a sheep inside a crabpot sandbox.",
      "repo": "https://github.com/shep-pm/shep-sandbox",
      "license": "MIT OR Apache-2.0",
      "category": "other",
      "source": {
        "kind": "cargo",
        "version": "0.2.3",
        "sha256": {
          "aarch64-apple-darwin": "500c2c5cdf61d9795c31dbf3f4ac143144dea3998aa9b19eee11eed00f2fe681",
          "aarch64-unknown-linux-gnu": "4eb19ae71ff767a994225733fd97c1e7040b55a2492a94b79c12180a8b1e6911",
          "aarch64-unknown-linux-musl": "afd5363485b96a106403371e6d0ee706c81fe9bd43288b4430cca005a58450ab",
          "x86_64-apple-darwin": "08f7c0eaaab9f34db061d623de23c8f3d6457ebf3ec8df11be10960c717d18ab",
          "x86_64-pc-windows-msvc": "7f5ed5079d78b749f24d6a22405b1ad74860b6d3158982f7dafaaa9b3556a316",
          "x86_64-unknown-linux-gnu": "ca05ca69d41ac4e76ff144f83d2279cc9afd1ae1a020a2829527c0066cbde44f",
          "x86_64-unknown-linux-musl": "6437bd4bce75ca311b6f1ed4f84ca287e7632549cdb645a2cb07bde6abc3ee8d"
        },
        "permissions": []
