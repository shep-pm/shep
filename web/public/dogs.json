{
  "$schema": "./dogs.schema.json",
  "version": 1,
  "shep": "0.24.2",
  "dogs": [
    {
      "name": "Bella",
      "package": "shep-log-rotate",
      "adopt_as": "log-rotate",
      "description": "Rotates grown log files and asks the shepherd to reopen them.",
      "repo": "https://github.com/shep-pm/shep-log-rotate",
      "license": "MIT OR Apache-2.0",
      "category": "logs",
      "source": {
        "kind": "cargo",
        "version": "0.2.10"
      },
      "needs": [
        "logs"
      ]
    },
    {
      "name": "Moon",
      "package": "shep-deploy",
      "adopt_as": "deploy",
      "description": "Watches a git branch, builds a release in an isolated directory, swaps to it, and rolls back on its own if the new release does not come up.",
      "repo": "https://github.com/shep-pm/shep-deploy",
      "license": "MIT OR Apache-2.0",
      "category": "deploy",
      "source": {
        "kind": "cargo",
        "version": "0.7.0"
      }
    },
    {
      "name": "Wumpus",
      "package": "shep-discord",
      "adopt_as": "discord",
      "description": "Streams a sheep's output into Discord channels, keeps a live embed for each one, and drives the flock from slash commands.",
      "repo": "https://github.com/shep-pm/shep-discord",
      "license": "MIT OR Apache-2.0",
      "category": "interactive",
      "source": {
        "kind": "cargo",
        "version": "0.3.5",
        "sha256": {
          "aarch64-apple-darwin": "d2a3a15abab5096de9d110d95376920b4adf9212d07d4e6b080c2058e21505e9",
          "aarch64-unknown-linux-gnu": "a1e8ca60c5775638bfc19c3a0aaeee441b3e2d9f350ebc7fb6413941fa9125f8",
          "aarch64-unknown-linux-musl": "0e31f8eee5e7bda115bb79f98b9a7768356fb5de015e33eadb8a003f4dc1f890",
          "x86_64-apple-darwin": "6fe3c563347b58730aa99776eb444ee7fe1f49914aaed8ccdede4c89d8b819ba",
          "x86_64-pc-windows-msvc": "db6b1d0b85e47eb682e7ea6534912b8e3776101b0f2782e186386abed0999668",
          "x86_64-unknown-linux-gnu": "88b0e7de27de9868a138f1d46842489e5ede3dc9bd64c0c8b273181f3f60ac78",
          "x86_64-unknown-linux-musl": "ccd1d536702775bcae1651673cb40463dcd18c4ef278123d368f9de1dd93f3c9"
        },
        "permissions": [
          {
            "name": "flock.read",
            "required": true
          },
          {
            "name": "events:log.",
            "required": true
          },
          {
            "name": "events:process.",
            "required": true
          },
          {
            "name": "flock.control",
            "required": false
          },
          {
            "name": "flock.edit",
            "required": false
          },
          {
            "name": "dogs.control",
            "required": false
          },
          {
            "name": "logs.manage",
            "required": false
          }
        ]
      },
      "needs": [
        "alerts"
      ]
    },
    {
      "name": "Paddy",
      "package": "shep-paddock",
      "adopt_as": "paddock",
      "description": "Leases one host's GPU and RAM to model servers and jobs, behind a single endpoint.",
      "repo": "https://github.com/shep-pm/shep-paddock",
      "license": "MIT OR Apache-2.0",
      "category": "other",
      "source": {
        "kind": "cargo"
      }
    },
    {
      "name": "Bao",
      "package": "shep-openbao",
      "adopt_as": "openbao",
      "description": "Mirrors secrets from OpenBao into shep's secrets store.",
      "repo": "https://github.com/shep-pm/shep-openbao",
      "license": "MIT OR Apache-2.0",
      "category": "other",
      "source": {
        "kind": "cargo"
      }
    },
    {
      "name": "Sandy",
      "package": "shep-sandbox",
      "adopt_as": "sandbox",
      "description": "Runs a sheep inside a crabpot sandbox.",
      "repo": "https://github.com/shep-pm/shep-sandbox",
      "license": "MIT OR Apache-2.0",
      "category": "other",
      "source": {
        "kind": "cargo",
        "version": "0.2.2"
      }
    }
  ]
}
